# Copy to .env and fill in real values. Never commit .env.

# MinIO (S3-compatible object storage)
MINIO_ACCESS_KEY=farol_admin
MINIO_SECRET_KEY=change_me_minio_secret
FAROL_RAW_BUCKET_NAME=farol-raw

# Postgres (DuckLake metadata catalog + Airflow metadata DB, one instance/two databases)
POSTGRES_USER=farol_admin
POSTGRES_PASSWORD=change_me_postgres_secret
POSTGRES_HOST=postgres

# DataJud (CNJ) — public but rate-limited, requires an API key
DATAJUD_API_KEY=change_me_datajud_key

# Bumped manually when a source's extraction logic changes; propagates into
# every ingested record's _source_version column.
SOURCE_VERSION=1.0.0
